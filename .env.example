# ===== Botwok environment (copy to .env) =====
APP_ENV=local                      # local | production
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:3000        # OAuth callbacks are built from this (use an HTTPS tunnel for platforms that require it)
PUBLIC_MEDIA_BASE_URL=                       # public URL for media renditions (Instagram/Threads/TikTok photos/GBP need this); empty = unavailable locally
SIGNUP_MODE=open                   # open | invite_only

# Security (generate with: python scripts/generate_master_key.py)
BOTWOK_MASTER_KEY=change-me-32-bytes-base64
JWT_SECRET=change-me-jwt-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Infrastructure
DATABASE_URL=postgresql+asyncpg://botwok:botwok@localhost:5432/botwok
DATABASE_URL_SYNC=postgresql://botwok:botwok@localhost:5432/botwok
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=botwok
S3_SECRET_KEY=botwok-secret
S3_REGION=us-east-1
S3_BUCKET_MEDIA=media
S3_BUCKET_DOCUMENTS=documents
S3_BUCKET_REPORTS=reports
EMBEDDING_DIMS=1536

# AI providers (optional here; can also be set per workspace in AI Settings)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=                    # free tier: https://aistudio.google.com/apikey
GROQ_API_KEY=                      # free developer tier: https://console.groq.com/keys
OPENROUTER_API_KEY=                # free models end in ":free": https://openrouter.ai/models?q=free
HUGGINGFACE_API_KEY=               # free inference credits: https://huggingface.co/settings/tokens
POLLINATIONS_API_KEY=              # optional; the public endpoint works without a key
FREE_FALLBACK_MODELS=pollinations/openai   # used when no provider above has a key (prompts go to a public free endpoint); empty = off
OLLAMA_BASE_URL=http://localhost:11434/v1
DEFAULT_CHEAP_MODEL=anthropic/claude-haiku-4-5-20251001
DEFAULT_BALANCED_MODEL=anthropic/claude-sonnet-5-5
DEFAULT_POWERFUL_MODEL=anthropic/claude-opus-5-5
DEFAULT_EMBEDDING_MODEL=openai/text-embedding-3-small

# Search providers (optional; SearXNG is used when none are set)
TAVILY_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=
SEARXNG_BASE_URL=http://localhost:8080

# Social platform developer apps (fill in to enable connections)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Email (local: mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=botwok@localhost
